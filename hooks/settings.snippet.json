{
  "//": "Merge this into ~/.claude/settings.json. Adjust the paths to hooks/session-start.sh and hooks/prompt-recall.sh.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/projects/anamnesis/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/projects/anamnesis/hooks/prompt-recall.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
