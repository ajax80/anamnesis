# Anamnesis configuration. Copy to one of:
#   $ANAMNESIS_ENV  (if you export it)   ~/.config/anamnesis/anamnesis.env   or  ./anamnesis.env
# and edit. Every value has a sane default; you can also just export these vars.

# --- data location -----------------------------------------------------------
# Where your memory files live. THIS IS YOUR DATA — never the engine repo.
# Point it at a private, git-tracked directory you control.
ANAMNESIS_DIR="$HOME/.anamnesis"

# --- node identity (for multi-machine / fleet use) ---------------------------
# Selects NOW.<node>.md as this machine's live-state pointer and tags sync commits.
ANAMNESIS_NODE="$(hostname)"

# Only this node regenerates INDEX.md + embeddings during maintenance.
# Leave EMPTY to let every node regenerate (fine for a single machine).
ANAMNESIS_INDEX_NODE=""

# --- semantic tier ------------------------------------------------------------
# "ollama" (HTTP, below) or "fastembed" (in-process, pip install fastembed)
ANAMNESIS_EMBED_BACKEND="ollama"
# Interpreter for search/index (e.g. a venv that has fastembed)
ANAMNESIS_PYTHON="python3"
ANAMNESIS_OLLAMA_URL="http://localhost:11434/api/embeddings"
ANAMNESIS_EMBED_MODEL="nomic-embed-text"

# --- overnight changelog (optional local LLM; degrades to a file list) --------
ANAMNESIS_OLLAMA_GEN_URL="http://localhost:11434/api/generate"
ANAMNESIS_CHANGELOG_MODEL="llama3.1:8b"

# --- fleet sync (optional) ---------------------------------------------------
# A bare git remote all your nodes share (a LAN box, NOT a public host if the
# data is private). Empty = sync is a no-op; Anamnesis still works locally.
ANAMNESIS_HUB_REMOTE=""
ANAMNESIS_HUB_BRANCH="main"

# Site-specific maintenance checks: a command printing "WARN ..."/"NOTE ..." lines
ANAMNESIS_MAINT_EXTRA=""

# CORE size soft cap (bytes) — maintenance warns above this.
ANAMNESIS_CORE_CAP="12288"
